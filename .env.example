# Copy to .env and fill in for local development. The service refuses to boot
# if any of these are unset.
PORT=3000

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Signing secret for session tokens (HS256).
JWT_SECRET=

# Upstream payment processor credential.
PAYMENT_API_KEY=

# Shared secret used to verify processor webhook signatures.
WEBHOOK_SECRET=

# Optional: maximum amount of any single refund via POST /refunds, in integer
# cents. Defaults to 50000 ($500.00) when unset or empty.
REFUND_MAX_CENTS=
